{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "./*.ts",
    "./browser/*.ts",
    "./fixtures/*.tsx",
    "../playwright.config.ts",
    "../playwright.ui1.config.ts",
    "../playwright.local-demo.config.ts"
  ]
}
