# Optional Gateway documentation on the host; never copy service credentials here.
# These values do not configure or recreate Docker Compose containers.
NODE_ENV=development
PORT=64345
GATEWAY_API_DOCS_ENABLED=false
GATEWAY_API_DOCS_TRY_IT_OUT=false
# Required only when Try it out is explicitly enabled; must match the browser origin.
GATEWAY_API_DOCS_ORIGIN=http://127.0.0.1:64345
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:64345
# Configure the existing *_SERVICE_URL variables only for approved reachable backends.
# Never publish private service ports simply to use the documentation UI.
