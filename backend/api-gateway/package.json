{
  "name": "@goleve/api-gateway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test:agenda": "npm run build && node --test tests/agenda-gateway.test.cjs",
    "docs:generate": "node ../../scripts/release-contracts.cjs --write && node ../../scripts/gateway-swagger.cjs --write",
    "docs:check": "node ../../scripts/release-contracts.cjs && node ../../scripts/gateway-swagger.cjs",
    "test:docs": "npm run docs:check && npm run build && node --test tests/api-docs.test.cjs tests/integration-boundary.test.cjs",
    "test:docs:browser": "npm run docs:check && npm run build && node --test tests/api-docs-browser.test.cjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "http-proxy-middleware": "^3.0.10",
    "swagger-ui-dist": "5.34.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
