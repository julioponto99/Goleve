# Disabled by default. Synthetic local use only; production activation is refused.
AI_COACH_ENABLED=false
AI_COACH_MODE=isolated
PORT=3011
MONGO_URI=
AUTH_SERVICE_URL=
USER_SERVICE_URL=
TRAINING_SERVICE_URL=
HYDRATION_SERVICE_URL=
PERFORMANCE_SERVICE_URL=
AGENDA_SERVICE_URL=
# Independent AI content encryption key: file containing 32 random bytes as hex.
AI_COACH_DATA_KEY_FILE=
# none | http-json-v1. No vendor credentials are bundled.
AI_COACH_PROVIDER=none
AI_COACH_PROVIDER_URL=
AI_COACH_MODEL=
AI_COACH_PROVIDER_KEY_FILE=
# Gateway configuration (set on the Gateway, not supplied by a model).
AI_COACH_SERVICE_URL=
