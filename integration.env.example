# Documentation only. The CLI writes its own ignored compose.env with a random instance.
# Do not copy credentials from .env, .secrets or another Compose project.
INTEGRATION_PORT=64344
# Generated by node scripts/integration.cjs init; never use a fixed instance/project ID.
# INTEGRATION_INSTANCE=<generated sixteen hexadecimal characters>
# INTEGRATION_PROJECT=goleve-integration-v1-<generated instance>
# INTEGRATION_ROOT=<absolute path to the ignored .integration instance directory>
# CORS_ALLOWED_ORIGINS is configured explicitly on the integration Gateway.
