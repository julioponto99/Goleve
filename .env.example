# Local Compose defaults; copying to .env is optional.
API_GATEWAY_PORT=3000
MONGO_PORT=27019
MONGO_DB_PREFIX=goleve
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Local credentials. Use URL-safe characters.
# RabbitMQ creates this user only on first volume initialization.
RABBITMQ_USER=goleve
RABBITMQ_PASSWORD=goleve-local
# Required by auth-service. Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production rejects short secrets, known development placeholders and repeated patterns.
JWT_SECRET=

# Phase 1 User Service is limited to fictitious data. Real-data mode is not implemented.
# Keep disabled unless this local environment is used exclusively with synthetic data.
USER_DATA_MODE=disabled
# Run npm run init:local --workspace=@goleve/user-service from backend first.
# The encryption key is a local file, not the Auth JWT key.
USER_DATA_KEY_PATH=./.secrets/user-data-key.key

# Examples for processes running on the host.
# Compose explicitly overrides these URLs with container addresses.
MONGO_URI=mongodb://127.0.0.1:27019/goleve_auth
RABBITMQ_URL=amqp://goleve:goleve-local@127.0.0.1:5672

# Inside Docker: mongodb://mongodb:27017/goleve_<service>
# Inside Docker: amqp://goleve:goleve-local@rabbitmq:5672
# Gateway receives AUTH_SERVICE_URL, USER_SERVICE_URL, etc.
